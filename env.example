# Copy to .env and fill in. Only NVIDIA_API_KEY is required to run debates.

# --- Model provider: NVIDIA NIM (OpenAI-compatible API) ---
# Get a key at https://build.nvidia.com (starts with "nvapi-"). Never commit it.
NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.3-70b-instruct
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=450
# LLM_SUMMARY_MAX_TOKENS=1200

# --- App ---
DATABASE_URI="sqlite:///database.db"
SECRET_KEY="change-me-to-a-long-random-string"
ENV="development"
# MAX_CONCURRENT_DEBATES=4
# AUTO_MIGRATE=true
